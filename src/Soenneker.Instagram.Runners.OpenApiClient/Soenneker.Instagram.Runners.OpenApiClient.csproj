<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A runner that regenerates and updates Soenneker.Instagram.OpenApiClient.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Instagram.Runners.OpenApiClient</AssemblyName>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.LoggerConfiguration" Version="4.0.1409" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="Soenneker.Managers.Runners" Version="4.0.2605" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Kiota.Util" Version="4.0.144" />
        <PackageReference Include="Soenneker.OpenApi.Fixer" Version="4.0.378" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Soenneker.Instagram.Runners.OpenApiClient.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\OpenApi\soenneker.openapi.converters.meta\src\Soenneker.OpenApi.Converters.Meta\Soenneker.OpenApi.Converters.Meta.csproj" Condition="Exists('..\..\..\..\OpenApi\soenneker.openapi.converters.meta\src\Soenneker.OpenApi.Converters.Meta\Soenneker.OpenApi.Converters.Meta.csproj')" />
        <PackageReference Include="Soenneker.OpenApi.Converters.Meta" Version="4.0.5" Condition="!Exists('..\..\..\..\OpenApi\soenneker.openapi.converters.meta\src\Soenneker.OpenApi.Converters.Meta\Soenneker.OpenApi.Converters.Meta.csproj')" />
    </ItemGroup>
</Project>
